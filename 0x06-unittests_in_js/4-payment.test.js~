const sinon = require('sinon');
const { expect } = require('chai');
const Utils = require('./utils');
const sendPaymentRequestToApi = require('./4-payment');

describe('sendPaymentRequestToApi', () => {
  it('sendPaymentRequestToApi uses console', () => {
    const bigBrother = sinon.spy(console);
    const dummy = sinon.stub(Utils, 'calculateNumber');

    dummy.returns(10);
    sendPaymentRequestToApi(100, 50);
    expect(bigBrother.log.calledWith('The total is: 10')).to.be.true;
    expect(bigBrother.calculateNumber.callCount).to.be.equal(1);
    expect(dummy.calledWith('SUM', 100, 50)).to.be.true;
    expect(dummy.callCount).to.be.equal(1);
    bigBrother.log.restore();
    dummy.restore();
  });
});
